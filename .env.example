# Copy this file to .env.local for local development.
# NEVER commit real keys.

# Required: your Anthropic API key
ANTHROPIC_API_KEY=

# Optional: override model (default: claude-opus-4-7)
# ANTHROPIC_MODEL=claude-opus-4-7

# Optional: soft limits for a single Run Now invocation
# CHECKER_MAX_RESPONSES=60
# CHECKER_MAX_BRAND_PAGES=18
# CHECKER_MAX_UNIQUE_CITATIONS=40
